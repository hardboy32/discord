DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
# Optional: use a test server ID so slash commands update immediately
DISCORD_GUILD_ID=
# Optional: your Discord user ID for activity-command ownership checks
# If unset, the bot tries to detect the application owner automatically
BOT_OWNER_ID=
# Optional: warning storage file; set this only if Infrlo has persistent storage
# WARNINGS_FILE=/app/data/warnings.json

# Free-tier Groq API key for AI replies; create one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Required: Discord bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Recommended: Application ID from Discord Developer Portal
DISCORD_CLIENT_ID=your_application_id_here

# Optional: test server ID for instant slash-command updates
DISCORD_GUILD_ID=

# Optional: your Discord user ID for /activity ownership checks
BOT_OWNER_ID=

# Optional: warning storage file. If you attach a Railway Volume at /app/data,
# the default path already stores warnings persistently there.
# WARNINGS_FILE=/app/data/warnings.json

# Optional: Groq API key enables AI chat replies
GROQ_API_KEY=

# Optional: defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Lavalink runs in the same Railway container as the bot. A private password
# is generated automatically at startup when this is left empty.
LAVALINK_PASSWORD=

# Optional: Java maximum heap size for Lavalink (default: 512m).
LAVALINK_JAVA_XMX=512m

# Dashboard: fixed single Discord server
DASHBOARD_GUILD_ID=686002315148394502
DISCORD_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=generate_a_long_random_secret
DASHBOARD_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/auth/callback
